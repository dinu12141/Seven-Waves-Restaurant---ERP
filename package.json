{
  "name": "restaurant-erp",
  "version": "0.0.1",
  "description": "Seven Waves Restaurant Management",
  "productName": "Seven Waves | Restaurant Management",
  "author": "dinu12141 <kmudinusha@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "type-check": "node --max-old-space-size=6144 node_modules/vue-tsc/bin/vue-tsc.js --noEmit --skipLibCheck",
    "dev": "quasar dev",
    "check:secrets": "node scripts/check-no-service-key-leak.mjs",
    "prebuild": "node scripts/check-no-service-key-leak.mjs",
    "build": "quasar build",
    "build:staging": "npm run check:secrets && VITE_APP_ENV=staging quasar build",
    "build:production": "npm run check:secrets && VITE_APP_ENV=production quasar build",
    "health-check": "bash scripts/health-check.sh",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@google/generative-ai": "^0.24.1",
    "@quasar/extras": "^1.16.4",
    "@sentry/vue": "^10.67.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "apexcharts": "^5.16.0",
    "axios": "^1.2.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.4",
    "quasar": "^2.16.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.22",
    "vue-i18n": "^11.0.0",
    "vue-router": "^5.0.0",
    "vue3-apexcharts": "^1.11.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@quasar/app-vite": "^2.1.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/chrome": "^0.1.38",
    "@types/node": "^25.5.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "docx": "^9.6.1",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "pdfkit": "^0.18.0",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "sharp": "^0.34.5",
    "typescript": "5.8.3",
    "vite-plugin-checker": "^0.11.0",
    "vitest": "^4.1.6",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.7",
    "workbox-build": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "overrides": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
