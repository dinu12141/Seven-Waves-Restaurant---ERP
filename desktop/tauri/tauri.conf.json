{
  "productName": "Seven Waves ERP",
  "identifier": "com.sevenwaves.erp",
  "version": "1.0.0",
  "build": {
    "beforeDevCommand": "npx quasar dev",
    "devUrl": "http://localhost:9000",
    "beforeBuildCommand": "npx quasar build",
    "frontendDist": "../../dist/spa"
  },
  "app": {
    "windows": [
      {
        "title": "Seven Waves ERP",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "icon": [
      "../../public/icons/icon-32x32.png",
      "../../public/icons/icon-128x128.png",
      "../../public/icons/icon-256x256.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": {
      "all": true
    }
  }
}
