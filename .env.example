# ═══════════════════════════════════════════════════════════════════
# Environment Variables — Local Development
# Seven Waves ERP — Step 03E
# ═══════════════════════════════════════════════════════════════════
# This file is gitignored. Copy from .env.example and fill values.

# ── Supabase ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# SERVER-ONLY service_role key — bypasses ALL RLS. MUST NOT use a VITE_ prefix
# (Vite inlines VITE_* into the public browser bundle). Used only by Node scripts
# under scripts/. Leave blank in browser/deploy environments.
SUPABASE_SERVICE_ROLE_KEY=

# ── App Metadata ─────────────────────────────────────────────────
VITE_APP_ENV=local
VITE_APP_VERSION=0.1.0-dev
VITE_APP_PUBLIC_URL=http://localhost:9000

# ── Feature Flags ────────────────────────────────────────────────
VITE_ENABLE_PWA=false
VITE_ENABLE_REALTIME=true
VITE_ENABLE_OFFLINE=true

# ── Integrations ─────────────────────────────────────────────────
VITE_GOOGLE_MAPS_KEY=your-google-maps-key-here
VITE_SENTRY_DSN=
VITE_DEFAULT_COMPANY_ID=

# ── Development Overrides ────────────────────────────────────────
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug
