# Copy this file to .env and fill in your values.
# For Vercel: set these in the Vercel project → Settings → Environment Variables.

# Supabase project URL (from Supabase project settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe to expose — controlled by RLS policies)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps JavaScript API key
# Enable: Maps JavaScript API, Directions API, Geocoding API
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_MAPS_KEY=your-google-maps-api-key-here

# Public base URL for QR code generation.
# Local dev:      http://192.168.1.xx:9000
# Production:     https://your-app.vercel.app
# Leave blank in Vercel — TablesManagementPage falls back to window.location.origin
VITE_APP_PUBLIC_URL=
